# Google Gemini API Key for Agent Core (if using real AI model, otherwise falls back to TestModel)
GEMINI_API_KEY=your-gemini-api-key-here

# Safety Guardrails
LIVE_MODE=false
MAX_DEMO_AMOUNT=5000.0

# Security Secrets
JWT_SECRET=razorpay-ai-buildathon-secret-key-2026
WEBHOOK_SECRET=razorpay_webhook_secret_key_2026

# Database & Cache Locations
REDIS_HOST=redis
REDIS_PORT=6379
DATABASE_URL=postgresql://postgres:postgres@db:5432/razorpay_mock

# Service Provider Overrides (ASR/TTS/VAD)
ASR_PROVIDER=mock
TTS_PROVIDER=mock
VAD_PROVIDER=simple
